# OpenSearch Dashboards configuration file generated by Ansible

server.host: "0.0.0.0"
server.port: {{ opensearch_dashboard_port }}
opensearch.hosts: ["http://{{ opensearch_host }}:{{ opensearch_port }}"]
opensearch.ssl.verificationMode: none

# Disable security plugin for development
opensearch_security.disabled: true

# Improved performance for limited resources
server.maxPayloadBytes: 1048576
opensearch.requestTimeout: 120000
opensearch.shardTimeout: 120000

# Allow embedding in iframes
server.xsrf.disableProtection: true
