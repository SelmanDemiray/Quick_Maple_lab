# OpenSearch configuration file generated by Ansible

cluster.name: security-monitoring
node.name: {{ ansible_hostname }}

network.host: {{ opensearch_host }}
http.port: {{ opensearch_port }}

discovery.type: single-node

# Path settings
path.data: /var/lib/opensearch
path.logs: /var/log/opensearch

# Disable security features for development setup
plugins.security.disabled: true

# Disable demo configuration
opensearch.initial_admin_password:

# Performance settings for limited resources
bootstrap.memory_lock: false
thread_pool.write.queue_size: 1000
thread_pool.search.queue_size: 1000
indices.queries.cache.size: 10%
indices.memory.index_buffer_size: 10%

# Allow CORS for Dashboard integration
http.cors.enabled: true
http.cors.allow-origin: "*"
http.cors.allow-methods: GET, POST, PUT, DELETE, OPTIONS
http.cors.allow-headers: X-Requested-With, X-Auth-Token, Content-Type, Content-Length, Authorization
