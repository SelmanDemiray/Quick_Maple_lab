# DHCP server configuration file generated by Ansible

# Global parameters
option domain-name "lab.local";
option domain-name-servers {{ containers.pihole.ip | regex_replace('/.*', '') }};
default-lease-time 600;
max-lease-time 7200;
ddns-update-style none;
authoritative;

# Define subnets
{% for range in dhcp_server_ranges %}
subnet {{ range.subnet }} netmask {{ range.netmask }} {
  range {{ range.range_start }} {{ range.range_end }};
  option subnet-mask {{ range.netmask }};
  option routers {{ gateway_ip }};
  option broadcast-address {{ range.subnet | regex_replace('\\.[0-9]+$', '.255') }};
}
{% endfor %}

# Define static IP addresses
host pihole {
  hardware ethernet 00:00:00:00:00:01;
  fixed-address {{ containers.pihole.ip | regex_replace('/.*', '') }};
}

host opensearch {
  hardware ethernet 00:00:00:00:00:02;
  fixed-address {{ containers.opensearch.ip | regex_replace('/.*', '') }};
}

host suricata {
  hardware ethernet 00:00:00:00:00:03;
  fixed-address {{ containers.suricata.ip | regex_replace('/.*', '') }};
}
